{
  "name": "chiikawa-quota-pet",
  "version": "0.4.0",
  "private": true,
  "description": "Chiikawa 本地 AI 额度桌宠",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "test:ept": "node scripts/ept-smoke.cjs",
    "build": "electron-builder --win dir --x64",
    "package:share": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "local.usagi.quota.pet",
    "productName": "ChiikawaQuotaPet",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
